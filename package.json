{
  "name": "51degrees-node",
  "version": "1.0.0",
  "private": true,
  "description": "The workspace that holds every 51Degrees Node.js package. It is never published.",
  "workspaces": [
    "pipeline/fiftyone.pipeline.core",
    "pipeline/fiftyone.pipeline.engines",
    "pipeline/fiftyone.pipeline.engines.fiftyone",
    "pipeline/fiftyone.pipeline.cloudrequestengine",
    "pipeline/fiftyone.pipeline.did",
    "pipeline/fiftyone.pipeline.translation",
    "pipeline/fiftyone.pipeline.derivedproperty",
    "device-detection/fiftyone.devicedetection",
    "device-detection/fiftyone.devicedetection.cloud",
    "device-detection/fiftyone.devicedetection.onpremise",
    "device-detection/fiftyone.devicedetection.shared",
    "location",
    "ip-intelligence/fiftyone.ipintelligence",
    "ip-intelligence/fiftyone.ipintelligence.cloud",
    "ip-intelligence/fiftyone.ipintelligence.onpremise",
    "ip-intelligence/fiftyone.ipintelligence.shared",
    "ip-intelligence/fiftyone.ipintelligence.translation"
  ],
  "scripts": {
    "unit-test": "node --expose-gc node_modules/jest/bin/jest.js --ci --reporters=jest-junit --reporters=default --runInBand --forceExit --coverage --coverageReporters=cobertura --testPathIgnorePatterns=\"(examples/|performance\\.test\\.js|integration|location/)\"",
    "integration-test": "node --expose-gc node_modules/jest/bin/jest.js --ci --reporters=jest-junit --reporters=default --runInBand --forceExit --coverage --coverageReporters=cobertura --testPathPattern=\"(examples/|integration|location/)\" --testPathIgnorePatterns=\"(performance\\.test\\.js|tierEntitlement\\.integration\\.test\\.js)\"",
    "lint": "eslint . --ext .js",
    "tsc": "tsc -b --force"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/51Degrees/51degrees-node"
  },
  "author": "51Degrees Engineering <engineering@51degrees.com>",
  "license": "EUPL-1.2",
  "jest-junit": {
    "outputName": "test_results.xml"
  },
  "jest": {
    "projects": [
      {
        "displayName": "ci",
        "rootDir": "ci"
      },
      {
        "displayName": "pipeline",
        "rootDir": "pipeline",
        "setupFilesAfterEnv": ["<rootDir>/setup.js"]
      },
      {
        "displayName": "device-detection",
        "rootDir": "device-detection",
        "setupFilesAfterEnv": ["<rootDir>/setup.js"]
      },
      {
        "displayName": "ip-intelligence",
        "rootDir": "ip-intelligence",
        "setupFilesAfterEnv": ["<rootDir>/setup.js"]
      },
      {
        "displayName": "location",
        "rootDir": "location",
        "testRunner": "jest-jasmine2",
        "setupFilesAfterEnv": ["<rootDir>/setup.js", "jest-expect-message"]
      }
    ]
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "n-readlines": "^1.0.1",
    "pug": "^3.0.2",
    "supertest": "^6.1.6"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.2.2",
    "eslint-plugin-jsdoc": "^38.1.6",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "jest": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "jest-jasmine2": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mustache": "^4.0.1",
    "node-mocks-http": "^1.10.1",
    "typescript": "^5.4.5",
    "uglify-js": "^3.8.1"
  }
}
