doctype html
html
  head
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Web Integration Example
    link(rel='stylesheet', href='/css/examples-main.min.css')
    link(rel='stylesheet', href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css')

  body
    .c-eg-page
      if (new Date().getTime() > dataFilePublishedTime + dataFileAgeWarning)
        .c-eg-alert
          | WARNING: This example is using a data file that is more than
          | #{dataFileAgeWarning} days old. A more recent data file may be needed
          | to correctly determine the details of the latest IP ranges. To get
          | the latest lite data file, run the get-data-files script in the
          | #[a(href='https://github.com/51Degrees/data') cxx/data]
          | submodule with -u, or -Update in PowerShell.
          | #[a(href='https://51degrees.com/contact-us?utm_source=code&utm_medium=example&utm_campaign=51degrees-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=web-integration-example') Contact us]
          | about the Enterprise data file, which includes automatic daily updates.

      h2.c-eg-page__title IP intelligence web integration example
      p.c-eg-page__lead
        | This example demonstrates the use of the Pipeline API to perform IP
        | intelligence within a simple Node web server. The IP address of the
        | requesting client is used as evidence, so the results below describe
        | the network, and location that the request came from.
      p.c-eg-page__lead
        | Note that when running locally, the client IP address will be a
        | loopback address, which will not produce any results. Supply an IP
        | address with the 'client-ip' query parameter to look up a specific
        | address. For example, '?client-ip=8.8.8.8'.

      noscript
        .c-eg-alert
          | WARNING: JavaScript is disabled in your browser.

      #content
        h3.c-eg-page__heading IP intelligence lookup
        form.c-eg-form(method='get')
          .c-eg-form__row
            label.b-label(for='client-ip') Enter IP Address:
            input.b-input(type='text', id='client-ip', name='client-ip', value=inputIpAddress, placeholder='e.g., 8.8.8.8')
            button.b-btn(type='submit') Look Up

        h3.c-eg-page__heading Detection results
        p.c-eg-page__lead
          | The following values are determined by server-side IP intelligence
          | on the first request.
        table.c-eg-table
          thead.c-eg-table__head
            tr.c-eg-table__row
              th.c-eg-table__cell Property
              th.c-eg-table__cell Value
          tbody
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Registered Name:
              td.c-eg-table__cell #{registeredName}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Registered Owner:
              td.c-eg-table__cell #{registeredOwner}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Registered Country:
              td.c-eg-table__cell #{registeredCountry}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key IP Range Start:
              td.c-eg-table__cell #{ipRangeStart}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key IP Range End:
              td.c-eg-table__cell #{ipRangeEnd}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Country:
              td.c-eg-table__cell #{country}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Country Code:
              td.c-eg-table__cell #{countryCode}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Country Code 3:
              td.c-eg-table__cell #{countryCode3}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Region:
              td.c-eg-table__cell #{region}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key State:
              td.c-eg-table__cell #{state}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Town:
              td.c-eg-table__cell #{town}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Latitude:
              td.c-eg-table__cell #{latitude}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Longitude:
              td.c-eg-table__cell #{longitude}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Areas:
              td.c-eg-table__cell #{areas}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Accuracy Radius:
              td.c-eg-table__cell #{accuracyRadius}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Time Zone Offset:
              td.c-eg-table__cell #{timeZoneOffset}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Country Codes Geographical:
              td.c-eg-table__cell
                ul
                  each c in countryCodesGeographical
                    li #{c}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Country Codes Population:
              td.c-eg-table__cell
                ul
                  each c in countryCodesPopulation
                    li #{c}
            tr.c-eg-table__row.c-eg-table__row--alt
              td.c-eg-table__cell.c-eg-table__cell--key Country Names Geographical All Translated:
              td.c-eg-table__cell
                select#CountryNamesGeographicalAllTranslated.form-control(name='CountryNamesGeographicalAllTranslated')
                  each name, i in countryNamesGeographicalAllTranslated
                    option(value=countryCodesGeographicalAll[i]) #{name}
            tr.c-eg-table__row
              td.c-eg-table__cell.c-eg-table__cell--key Country Names Population All Translated:
              td.c-eg-table__cell
                select#CountryNamesPopulationAllTranslated.form-control(name='CountryNamesPopulationAllTranslated')
                  each name, i in countryNamesPopulationAllTranslated
                    option(value=countryCodesPopulationAll[i]) #{name}

        h3.c-eg-page__heading Evidence used
        p.c-eg-legend
          | Evidence was
          span.c-eg-legend__swatch.c-eg-legend__swatch--used used
          | /
          span.c-eg-legend__swatch.c-eg-legend__swatch--present present
          | for detection
        table.c-eg-table
          thead.c-eg-table__head
            tr.c-eg-table__row
              th.c-eg-table__cell Key
              th.c-eg-table__cell Value
          tbody
            each value, key in allEvidence
              if evidenceUsed[key] !== undefined
                tr.c-eg-table__row.c-eg-table__row--used
                  td.c-eg-table__cell.c-eg-table__cell--key #{key}
                  td.c-eg-table__cell #{value}
              else
                tr.c-eg-table__row.c-eg-table__row--present
                  td.c-eg-table__cell.c-eg-table__cell--key #{key}
                  td.c-eg-table__cell #{value}

        #map-section.c-eg-map(style='display: none;')
          h3.c-eg-map__title Location Map
          #map.c-eg-map__canvas

      if freeDataFile
        .c-eg-message
          p.c-eg-message__text Need more on-premise properties and features? #[a(href='https://51degrees.com/contact-us?utm_source=code&utm_medium=example&utm_campaign=51degrees-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=on-premise-properties') Contact us] to explore the options.
          a.b-btn.c-eg-message__cta(href='https://51degrees.com/contact-us?utm_source=code&utm_medium=example&utm_campaign=51degrees-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=on-premise-properties') Contact us

      .c-eg-section
        h3.c-eg-page__heading Find out more
        ul
          li
            | This API:
            |
            a(href='https://github.com/51Degrees/51degrees-node/tree/main/ip-intelligence') https://github.com/51Degrees/51degrees-node/tree/main/ip-intelligence
          li
            | The IP Intelligence engine:
            |
            a(href='https://github.com/51Degrees/51degrees-cxx') https://github.com/51Degrees/51degrees-cxx
          li
            | The Pipeline API:
            |
            a(href='https://github.com/51Degrees/51degrees-node/tree/main/pipeline') https://github.com/51Degrees/51degrees-node/tree/main/pipeline
          li
            a(href='https://51degrees.com/documentation/_ip_intelligence__overview.html?utm_source=code&utm_medium=example&utm_campaign=51degrees-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=find-out-more-documentation') IP Intelligence documentation
          li
            a(href='https://51degrees.com/pricing?utm_source=code&utm_medium=example&utm_campaign=51degrees-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=find-out-more-pricing') Data files and pricing
          li
            a(href='https://51degrees.com/contact-us?utm_source=code&utm_medium=example&utm_campaign=51degrees-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=find-out-more-contact') Contact us

    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js')
    script(src='https://unpkg.com/wellknown@0.5.0/wellknown.js')
    script(src='/js/examples.min.js')
    script.
      window.onload = function () {
        fodExamples.initLocationMap({
          areasWkt: '#{mapAreas}',
          latitude: '#{mapLatitude}',
          longitude: '#{mapLongitude}'
        });
      };
