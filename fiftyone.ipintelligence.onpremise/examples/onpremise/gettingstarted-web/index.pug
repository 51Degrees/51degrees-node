doctype html
html
  head
    title Web Integration Example
    style.
      a {
        color: #0366d6;
      }

      html {
        font-size: 14px;
      }
      @media (min-width: 768px) {
        html {
          font-size: 16px;
        }
      }

      html {
        position: relative;
        min-height: 100%;
      }

      body {
        margin-bottom: 60px;
      }

      .example-alert {
        border: 2px solid red;
      }

      .used-evidence {
        background-color: lightgreen;
      }

  body
    h2 Web Integration Example
    p
      | This example demonstrates the use of the Pipeline API to perform IP
      | intelligence within a simple Node web server. The IP address of the
      | requesting client is used as evidence, so the results below describe
      | the network, and location that the request came from.
    p
      | Note that when running locally, the client IP address will be a
      | loopback address, which will not produce any results. Supply an IP
      | address with the 'client-ip' query parameter to look up a specific
      | address. For example, '?client-ip=8.8.8.8'.

    if (new Date().getTime() > dataFilePublishedTime + dataFileAgeWarning)
      div(class='example-alert')
        | WARNING: This example is using a data file that is more than
        | #{dataFileAgeWarning} days old. A more recent data file may be needed
        | to correctly determine the details of the latest IP ranges. The
        | latest lite data file is available from the
        | #[a(href='https://github.com/51Degrees/ip-intelligence-data') ip-intelligence-data]
        | repository on Github. Find out about the
        | Enterprise data file, which includes automatic daily updates, on our
        | #[a(href='https://51degrees.com/pricing?utm_source=code&utm_medium=example&utm_campaign=ip-intelligence-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=web-integration-example') pricing page].

    div(id='content')
      div(id='evidence')
        p Evidence values used:
        table
          tr
            th Key
            th Value
          each value, key in allEvidence
            if evidenceUsed[key] !== undefined
              tr(class="used-evidence")
                td #{key}
                td #{value}
            else
              tr
                td #{key}
                td #{value}

      p
        | The following values are determined by server-side IP intelligence
        | on the first request:

      table
        tr
          th Key
          th Value
        tr
          td
            b Registered Name:
          td #{registeredName}
        tr
          td
            b Registered Owner:
          td #{registeredOwner}
        tr
          td
            b Registered Country:
          td #{registeredCountry}
        tr
          td
            b IP Range Start:
          td #{ipRangeStart}
        tr
          td
            b IP Range End:
          td #{ipRangeEnd}
        tr
          td
            b Country:
          td #{country}
        tr
          td
            b Country Code:
          td #{countryCode}
        tr
          td
            b Town:
          td #{town}
        tr
          td
            b Latitude:
          td #{latitude}
        tr
          td
            b Longitude:
          td #{longitude}
      br

      if (dataSourceTier === 'Lite')
        div(class='example-alert')
          | WARNING: You are using the free 'Lite' data file. This includes a
          | restricted set of properties. Find out about the Enterprise
          | data file on our #[a(href='https://51degrees.com/pricing?utm_source=code&utm_medium=example&utm_campaign=ip-intelligence-node&utm_content=fiftyone.ipintelligence.onpremise-examples-onpremise-gettingstarted-web-index.pug&utm_term=lite-data-file') pricing page].
