{
    'variables': {
        'encoding': [
            '_UNICODE',
            'UNICODE'
        ],
        'module_name': 'FiftyOneDeviceDetectionHashV4',
        'core_lib_name': '<(module_name)Core',
        'win_warning_level': 4,
        'win_exception_handling': 1,
        'win_warn_as_error': 'true',
        # Each target is built with one C standard and one C++ standard, and
        # Node's own standard option is taken out where it differs, so the
        # compiler never sees two. MSVC warns (D9025) when one standard
        # overrides another, and /WX does not make that an error.
        'node_major_version': "<!(node -p \"parseInt(process.versions.node)\")",
        'linux_c_std': '-std=gnu11',
        'mac_c_std': 'gnu11',
        'core_win_cpp_std': 'stdcpp17',
        'core_mac_cpp_std': 'gnu++17',
        # Node 23+ (V8 12.9+) headers require C++20, older versions build with C++17
        'wrapper_win_cpp_std': "<!(node -p \"parseInt(process.versions.node) >= 23 ? 'stdcpp20' : 'stdcpp17'\")",
        'wrapper_mac_cpp_std': "<!(node -p \"parseInt(process.versions.node) >= 23 ? 'gnu++20' : 'gnu++17'\")",
        'linux_mac_c_common_flags': [
            "<!(node -e \"\
            var v8Version = process.versions.v8;\
            var string = '-DSWIG_V8_VERSION=0x';\
            var arr = v8Version.split('.');\
            for (var i = 0; i < 3; i++) {\
                if (arr[i].length === 1) {\
                    string += '0';\
                    }\
                string += arr[i];\
            }\
            console.log(string);\")",
            "-Wall",
            "-Wextra",
            "-Werror"
        ],
        'mac_specific_flags': [
            "-arch x86_64",
            "-arch arm64"
        ]
    },
    # Node's own build settings turn some warnings off for every addon. They
    # are taken out here so these targets build with every warning the
    # warning level gives.
    'target_defaults': {
        'msvs_disabled_warnings!': [4351, 4355, 4800, 4251, 4275, 4244, 4267],
        'defines!': ['_CRT_SECURE_NO_DEPRECATE', '_CRT_NONSTDC_NO_DEPRECATE'],
        'cflags!': ['-Wno-unused-parameter'],
        'xcode_settings': {
            'WARNING_CFLAGS!': ['-Wno-unused-parameter']
        },
        # Node 26's build settings ask for clang's thin LTO and profile
        # guided optimisation, which MSVC does not know. The linker warns
        # about each option (LNK4044), so they are taken out.
        'msvs_settings': {
            'VCCLCompilerTool': {
                # Node's settings also pass -std:c++20 to MSVC for every
                # addon. Each target here sets its standard with
                # LanguageStandard, so Node's option is taken out.
                'AdditionalOptions/': [
                    ['exclude', '^[-/]f(lto|profile-use)'],
                    ['exclude', '^[-/]std:']
                ]
            },
            'VCLibrarianTool': {
                'AdditionalOptions/': [['exclude', '^[-/]f(lto|profile-use)']]
            },
            'VCLinkerTool': {
                'AdditionalOptions/': [['exclude', '^[-/]f(lto|profile-use)']],
                # node-gyp turns off the linker's warning for a delay loaded
                # DLL that nothing is imported from (LNK4199). It is taken
                # out so that warning shows too.
                'AdditionalOptions!': ['/ignore:4199']
            }
        }
    },
    'targets': [
        {
            'target_name': '<(core_lib_name)',
            'sources': [
                # Common C
                "<!@(node -p \"d='../../cxx/src/common/';require('fs').readdirSync(d).filter(f=>f.endsWith('.c')).map(f=>d+f).join(' ')\")",
                # Common C++
                "<!@(node -p \"d='../../cxx/src/common/';require('fs').readdirSync(d).filter(f=>f.endsWith('.cpp')).map(f=>d+f).join(' ')\")",
                # Device Detection C
                "<!@(node -p \"d='../../cxx/src/dd/';require('fs').readdirSync(d).filter(f=>f.endsWith('.c')).map(f=>d+f).join(' ')\")",
                # Device Detection C++
                "<!@(node -p \"d='../../cxx/src/dd/';require('fs').readdirSync(d).filter(f=>f.endsWith('.cpp')).map(f=>d+f).join(' ')\")",
                # Hash C
                "<!@(node -p \"d='../../cxx/src/dd/hash/';require('fs').readdirSync(d).filter(f=>f.endsWith('.c')).map(f=>d+f).join(' ')\")",
                # Hash C++
                "<!@(node -p \"d='../../cxx/src/dd/hash/';require('fs').readdirSync(d).filter(f=>f.endsWith('.cpp')).map(f=>d+f).join(' ')\")",
            ],
            'type': 'static_library',
            'conditions': [
                ['OS=="win"', {
				    'msvs_version':'2019',
				    'msvs_target_platform_minversion':'10.0.18362.0',
                    'configurations': {
                        'Debug': {
                            'msvs_settings': {
                                'VCCLCompilerTool': {
                                    'LanguageStandard': '<(core_win_cpp_std)',
                                    'WarningLevel': '<(win_warning_level)',
                                    'ExceptionHandling': '<(win_exception_handling)',
                                    'WarnAsError': '<(win_warn_as_error)',
                                    'PreprocessorDefinitions': [
                                        '<@(encoding)'
                                    ]
                                },
                                'VCLibrarianTool': {
                                    'TreatLibWarningAsErrors': '<(win_warn_as_error)'
                                },
                                'VCLinkerTool': {
                                    'TreatLinkerWarningAsErrors': '<(win_warn_as_error)'
                                }
                            }
                        },
                        'Release': {
                            'msvs_settings': {
                                'VCCLCompilerTool': {
                                    'LanguageStandard': '<(core_win_cpp_std)',
                                    'WarningLevel': '<(win_warning_level)',
                                    'ExceptionHandling': '<(win_exception_handling)',
                                    'WarnAsError': '<(win_warn_as_error)',
                                    'PreprocessorDefinitions': [
                                        '<@(encoding)'
                                    ]
                                },
                                'VCLibrarianTool': {
                                    'TreatLibWarningAsErrors': '<(win_warn_as_error)'
                                },
                                'VCLinkerTool': {
                                    'TreatLinkerWarningAsErrors': '<(win_warn_as_error)'
                                }
                            }
                        }
                    }
                }],
                ['OS=="mac"', {
                    "xcode_settings": {
                        "GCC_ENABLE_CPP_EXCEPTIONS": "YES",
                        "GCC_C_LANGUAGE_STANDARD": '<(mac_c_std)',
                        "CLANG_CXX_LANGUAGE_STANDARD": '<(core_mac_cpp_std)',
                        "OTHER_CFLAGS": [
                            '<@(linux_mac_c_common_flags)',
                            '<@(mac_specific_flags)'],
                        "OTHER_CPLUSPLUSFLAGS": [
                            '<@(linux_mac_c_common_flags)',
                            '<@(mac_specific_flags)']
                    }
                }],
                ['OS=="linux"', {
                    'cflags_cc!': ["-fno-exceptions"],
                    'cflags_c': ['<(linux_c_std)'],
                    # Node's settings give C++17 before Node 23, which is
                    # what the core library uses, and C++20 from Node 23,
                    # which is replaced.
                    'conditions': [
                        ['node_major_version>=23', {
                            'cflags_cc!': ['-std=gnu++20'],
                            'cflags_cc': ['-std=gnu++17']
                        }]
                    ],
                    'cflags': [
                        '<@(linux_mac_c_common_flags)'
                    ],
                    'libraries': ["-latomic"]
                }]
            ],
        },
        {
            'target_name': '<(module_name)',
            # hash.i and ipi.i include through cxx/.
            'include_dirs': ['../..'],
            'sources': [
                # Node Wrapper
                "hash_node_wrap.cxx",
            ],
            'dependencies': ['<(core_lib_name)'],
            # Stop the SWIG wrapper turning off MSVC's unreferenced function
            # warning and the deprecation warnings of the C and C++ runtimes.
            'defines': [
                'SWIG_MSC_UNSUPPRESS_4505',
                'SWIG_NO_CRT_SECURE_NO_DEPRECATE',
                'SWIG_NO_SCL_SECURE_NO_DEPRECATE'
            ],
            'conditions': [
                ['OS=="win"', {
                    'libraries': ['<(core_lib_name).lib'],
                    # Node's own headers (Node, V8, libuv and OpenSSL, all in
                    # its include folder) are read as external headers, so
                    # the compiler does not report warnings in code this
                    # repository cannot change. This repository's code, the
                    # cxx code and the wrapper keep every warning as an error.
                    'msvs_settings': {
                        'VCCLCompilerTool': {
                            'AdditionalOptions': [
                                '/external:I<(node_root_dir)/include/node'
                            ]
                        }
                    },
                    # Sets the warning level of external headers to none.
                    'msbuild_props': ['../../node-external-headers.props'],
                    'configurations': {
                        'Debug': {
                            'msvs_settings': {
                                'VCCLCompilerTool': {
                                    'LanguageStandard': '<(wrapper_win_cpp_std)',
                                    'WarningLevel': '<(win_warning_level)',
                                    'ExceptionHandling': '<(win_exception_handling)',
                                    'WarnAsError': '<(win_warn_as_error)',
                                    'PreprocessorDefinitions': [
                                        '<@(encoding)'
                                    ]
                                },
                                'VCLinkerTool': {
                                    'TreatLinkerWarningAsErrors': '<(win_warn_as_error)',
                                    'AdditionalLibraryDirectories': ['<(PRODUCT_DIR)'],
                                    'LinkIncremental': 1
                                }
                            }
                        },
                        'Release': {
                            'msvs_settings': {
                                'VCCLCompilerTool': {
                                    'LanguageStandard': '<(wrapper_win_cpp_std)',
                                    'WarningLevel': '<(win_warning_level)',
                                    'ExceptionHandling': '<(win_exception_handling)',
                                    'WarnAsError': '<(win_warn_as_error)',
                                    'PreprocessorDefinitions': [
                                        '<@(encoding)'
                                    ]
                                },
                                'VCLinkerTool': {
                                    'TreatLinkerWarningAsErrors': '<(win_warn_as_error)',
                                    'AdditionalLibraryDirectories': ['<(PRODUCT_DIR)']
                                }
                            }
                        }
                    }
                }],
                ['OS!="win"', {
                    'libraries': ['<(PRODUCT_DIR)/<(core_lib_name).a'],
                }],
                ['OS=="mac"', {
                    "xcode_settings": {
                        "GCC_ENABLE_CPP_EXCEPTIONS": "YES",
                        "GCC_C_LANGUAGE_STANDARD": '<(mac_c_std)',
                        "CLANG_CXX_LANGUAGE_STANDARD": '<(wrapper_mac_cpp_std)',
                        "OTHER_CFLAGS": [
                            '<@(linux_mac_c_common_flags)',
                            '<@(mac_specific_flags)'
                        ],
                        "OTHER_CPLUSPLUSFLAGS": [
                            '<@(linux_mac_c_common_flags)',
                            '<@(mac_specific_flags)',
                            # Node's own headers are system headers, as on
                            # Windows.
                            '-isystem<(node_root_dir)/include/node'
                        ],
                        "OTHER_LDFLAGS": [
                            '<@(mac_specific_flags)'
                        ]
                    },
                }],
                ['OS=="linux"', {
                    'cflags_cc!': ['-fno-exceptions'],
                    # Node's settings give the C++ standard the wrapper needs,
                    # C++17 before Node 23 and C++20 from Node 23, so it adds
                    # none of its own.
                    'cflags_c': ['<(linux_c_std)'],
                    # Node's own headers are system headers, as on Windows.
                    'cflags_cc': ['-isystem<(node_root_dir)/include/node'],
                    'cflags': [
                        '<@(linux_mac_c_common_flags)'
                    ],
                    'libraries': ["-latomic"]
                }]
            ],
        }
    ]
}

